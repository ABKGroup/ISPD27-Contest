# ============================================================================
# Test (Scan Shift) Mode SDC (Generated by DesignKit)
# Separate Clock: test_clk on shared clock ports clk
# Period: clk_period below, the functional clock period of this corner
# Case Analysis: Scan Enable = 1 (4326 targets)
# ============================================================================
if { ![info exists ::env(PLATFORM_DIR)] || $::env(PLATFORM_DIR) eq "" } {
  set ::env(PLATFORM_DIR) "/OpenROAD-flow-scripts/flow/platforms/asap7"
}
current_design jpeg_encoder

set clk_name clk
set clk_port_name clk
set clk_period 550
# Match the old set_input/output_delay = 0.2 * clk_period budget, as
# optimization targets only (no set_input/output_delay — see rationale in
# $PLATFORM_DIR/util/constraints.sdc).
set in2reg_max [expr { $clk_period * 0.8 }]
set reg2out_max [expr { $clk_period * 0.8 }]
set in2out_max [expr { $clk_period * 0.6 }]

source [file join $::env(PLATFORM_DIR) util constraints.sdc]

set_max_fanout 10 [current_design]

set_clock_uncertainty -setup 0 [all_clocks]
set_clock_uncertainty -hold 35 [all_clocks]

# --- DFT Test Mode Clock & I/O Constraints ---
create_clock -name test_clk -period $clk_period [get_ports {clk}]
set_propagated_clock [get_clocks test_clk]
set_clock_uncertainty -setup 0 [get_clocks test_clk]
set_clock_uncertainty -hold 35 [get_clocks test_clk]
set _non_clk_in [all_inputs -no_clocks]
set_max_delay -ignore_clock_latency $in2reg_max -from $_non_clk_in -to [all_registers]
set_max_delay -ignore_clock_latency $reg2out_max -from [all_registers] -to [all_outputs]
set_max_delay $in2out_max -from $_non_clk_in -to [all_outputs]

# --- DFT Test Mode Case Analysis (SE = 1) ---
if { [llength [get_ports -quiet scan_enable_0]] > 0 } {
  set_case_analysis 1 [get_ports scan_enable_0]
}
set _dft_se_pins [get_pins -quiet -of_objects [get_cells -hier *] -filter "lib_pin_name == SE"]
if { [llength $_dft_se_pins] > 0 } {
  set_case_analysis 1 $_dft_se_pins
}

set _dft_reg_d [get_pins -quiet -of_objects [all_registers -cells] -filter "lib_pin_name == D"]
if { [llength $_dft_reg_d] > 0 } {
  set_false_path -to $_dft_reg_d
}
puts "DFT_REG_D_FALSE_PATH [llength $_dft_reg_d]"
