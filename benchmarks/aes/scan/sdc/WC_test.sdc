# ============================================================================
# Test (Scan Shift) Mode SDC (Generated by DesignKit)
# Separate Clock: test_clk on shared clock ports clk
# Period: clk_period below, the functional clock period of this corner
# Case Analysis: Scan Enable = 1 (563 targets)
# ============================================================================
if { ![info exists ::env(PLATFORM_DIR)] || $::env(PLATFORM_DIR) eq "" } {
  set ::env(PLATFORM_DIR) "/OpenROAD-flow-scripts/flow/platforms/asap7"
}
set clk_name clk
set clk_port_name clk
set clk_period 429
set clk_io_pct 0.2

set clk_port [get_ports $clk_port_name]

create_clock -name $clk_name -period $clk_period $clk_port
set clk_io_name vclk_$clk_name
create_clock -name $clk_io_name -period $clk_period
set_clock_latency 77.930 [get_clocks $clk_name]
set_clock_latency 77.930 [get_clocks $clk_io_name]

set non_clock_inputs [all_inputs -no_clocks]

set_input_delay [expr $clk_period * $clk_io_pct] -clock $clk_io_name $non_clock_inputs
set_output_delay [expr $clk_period * $clk_io_pct] -clock $clk_io_name [all_outputs]

set_clock_uncertainty -setup 0 [all_clocks]
set_clock_uncertainty -hold 55 [all_clocks]

# --- DFT Test Mode Clock & I/O Constraints ---
create_clock -name test_clk -period $clk_period [get_ports {clk}]
set_propagated_clock [get_clocks test_clk]
set_clock_uncertainty -setup 0 [get_clocks test_clk]
set_clock_uncertainty -hold 55 [get_clocks test_clk]
create_clock -name vclk_clk -period $clk_period
if { [llength [get_ports -quiet {scan_enable* scan_in*}]] > 0 } {
  set_input_delay [expr $clk_period * $clk_io_pct] -clock test_clk [get_ports -quiet {scan_enable* scan_in*}]
}
if { [llength [get_ports -quiet {scan_out*}]] > 0 } {
  set_output_delay [expr $clk_period * $clk_io_pct] -clock test_clk [get_ports -quiet {scan_out*}]
}

# --- DFT Test Mode Case Analysis (SE = 1) ---
if { [llength [get_ports -quiet scan_enable_0]] > 0 } {
  set_case_analysis 1 [get_ports scan_enable_0]
}
set _dft_se_pins [get_pins -quiet -of_objects [get_cells -hier *] -filter "lib_pin_name == SE"]
if { [llength $_dft_se_pins] > 0 } {
  set_case_analysis 1 $_dft_se_pins
}

set _dft_reg_d [get_pins -quiet -of_objects [all_registers -cells] -filter "lib_pin_name == D"]
if { [llength $_dft_reg_d] > 0 } {
  set_false_path -to $_dft_reg_d
}
puts "DFT_REG_D_FALSE_PATH [llength $_dft_reg_d]"

# ISPD27: hold is not checked on paths that start at an input port.
set_false_path -hold -from [all_inputs -no_clocks]
