# ============================================================================
# Functional Mode SDC (Generated by DesignKit)
# Clock: clk on port clk (period = 429.000000 ps)
# Case Analysis: Scan Enable = 0 (563 targets)
# ============================================================================
if { ![info exists ::env(PLATFORM_DIR)] || $::env(PLATFORM_DIR) eq "" } {
  set ::env(PLATFORM_DIR) "/OpenROAD-flow-scripts/flow/platforms/asap7"
}
set clk_name clk
set clk_port_name clk
set clk_period 429
set clk_io_pct 0.2

set clk_port [get_ports $clk_port_name]

create_clock -name $clk_name -period $clk_period $clk_port
set clk_io_name vclk_$clk_name
create_clock -name $clk_io_name -period $clk_period
set_clock_latency 77.930 [get_clocks $clk_name]
set_clock_latency 77.930 [get_clocks $clk_io_name]

set non_clock_inputs [all_inputs -no_clocks]

set_input_delay [expr $clk_period * $clk_io_pct] -clock $clk_io_name $non_clock_inputs
set_output_delay [expr $clk_period * $clk_io_pct] -clock $clk_io_name [all_outputs]

set_clock_uncertainty -setup 0 [all_clocks]
set_clock_uncertainty -hold 55 [all_clocks]

# --- DFT Functional Mode Constraints (SE = 0) ---
set_propagated_clock [all_clocks]
if { [llength [get_ports -quiet {scan_enable* scan_in*}]] > 0 } {
  set_input_delay 85.80 -clock clk [get_ports -quiet {scan_enable* scan_in*}]
}
if { [llength [get_ports -quiet scan_enable_0]] > 0 } {
  set_case_analysis 0 [get_ports scan_enable_0]
}
set _dft_se_pins [get_pins -quiet -of_objects [get_cells -hier *] -filter "lib_pin_name == SE"]
if { [llength $_dft_se_pins] > 0 } {
  set_case_analysis 0 $_dft_se_pins
}

# ISPD27: scan shift paths (into SI) are timed in scan test mode only.
set _dft_reg_si [get_pins -quiet -of_objects [all_registers -cells] -filter "lib_pin_name == SI"]
if { [llength $_dft_reg_si] > 0 } {
  set_false_path -to $_dft_reg_si
}
